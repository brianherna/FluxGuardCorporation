MONGODB_URI=mongodb://localhost:27017/fluxg
MONGODB_DATABASE=fluxg
SERVER_PORT=8080
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=

# URL pública de la app (se usa en el enlace del correo de verificación)
APP_BASE_URL=http://localhost:8080

# Orígenes extra que pueden llamar a la API (separados por coma). Por defecto: APP_BASE_URL y localhost.
CORS_ALLOWED_ORIGINS=

# Clave para consultar prospectos: GET /api/prospectos con el encabezado X-Admin-Key. Vacía = consulta deshabilitada.
ADMIN_API_KEY=

# Brevo (correo de verificación de cuenta) — https://app.brevo.com/settings/keys/api
# El remitente debe estar verificado en Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FluxGuard

# PayPal — https://developer.paypal.com/dashboard/applications/sandbox (Apps & Credentials, pestaña Sandbox)
# PAYPAL_MODE=sandbox: pagos de prueba con cuentas ficticias, no se mueve dinero real. live = pagos reales.
# El Client Secret es secreto: nunca lo pongas en el frontend.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=MXN

# Resend — https://resend.com (alternativa a Brevo). Si RESEND_API_KEY tiene valor, se usa Resend en lugar de Brevo.
# El dominio del remitente debe estar verificado en Resend > Domains. RESEND_FROM_EMAIL vacío = usa BREVO_SENDER_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
